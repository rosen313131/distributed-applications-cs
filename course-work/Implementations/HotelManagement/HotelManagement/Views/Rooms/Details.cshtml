@model HotelManagement.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<h1>Room Details</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Number</dt>
            <dd class="col-sm-9">@Model.RoomNumber</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type</dd>

            <dt class="col-sm-3">Price per night</dt>
            <dd class="col-sm-9">
                @Model.PricePerNight.ToString("0.00")
            </dd>

            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>

            <dt class="col-sm-3">Wifi</dt>
            <dd class="col-sm-9">@(Model.HasWifi ? "Yes" : "No")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Last renovated</dt>
            <dd class="col-sm-9">@Model.LastRenovated?.ToShortDateString()</dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</p>

