@model HotelManagement.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<h1>Delete Room</h1>

<h3>Are you sure you want to delete this room?</h3>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Number</dt>
            <dd class="col-sm-9">@Model.RoomNumber</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type</dd>

            <dt class="col-sm-3">Price per night</dt>
            <dd class="col-sm-9">
                @Model.PricePerNight.ToString("0.00")
            </dd>

            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

