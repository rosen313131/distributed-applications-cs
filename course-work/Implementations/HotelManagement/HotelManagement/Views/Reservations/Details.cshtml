@model HotelManagement.Models.Reservation

@{
    ViewData["Title"] = "Reservation Details";
}

<h1>Reservation Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@Model.Room.RoomNumber</dd>

        <dt class="col-sm-2">Guest</dt>
        <dd class="col-sm-10">@Model.Guest.FullName</dd>

        <dt class="col-sm-2">Check-In</dt>
        <dd class="col-sm-10">@Model.CheckInDate</dd>

        <dt class="col-sm-2">Check-Out</dt>
        <dd class="col-sm-10">@Model.CheckOutDate</dd>

        <dt class="col-sm-2">Total Price</dt>
        <dd class="col-sm-10">@Model.TotalPrice</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>

    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
