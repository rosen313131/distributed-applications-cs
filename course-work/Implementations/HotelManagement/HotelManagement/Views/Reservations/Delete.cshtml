@model HotelManagement.Models.Reservation

@{
    ViewData["Title"] = "Delete Reservation";
}

<h1>Delete Reservation</h1>

<div>
    <h4>Are you sure you want to delete this reservation?</h4>

    <hr />

    <dl class="row">
        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@Model.Room.RoomNumber</dd>

        <dt class="col-sm-2">Guest</dt>
        <dd class="col-sm-10">@Model.Guest.FullName</dd>

        <dt class="col-sm-2">Check-In</dt>
        <dd class="col-sm-10">@Model.CheckInDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Check-Out</dt>
        <dd class="col-sm-10">@Model.CheckOutDate.ToShortDateString()</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
